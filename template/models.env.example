# Shared agent env. Copy to ~/.model/models.env, chmod 600, never commit.
# Source it: `set -a; . ~/.model/models.env; set +a`
#
# Real values come from your secret manager, not from this file's history.
# Each agent reads only its own section.

# --- Claude ---
ANTHROPIC_API_KEY=

# --- Codex ---
OPENAI_API_KEY=

# --- Grok ---
XAI_API_KEY=

# --- Antigravity ---
ANTIGRAVITY_API_KEY=

# --- Gemini ---
GEMINI_API_KEY=

# --- Shared infrastructure ---
# Keys the agents need for the platforms you actually run on.
# CLOUDFLARE_API_TOKEN=
# GITHUB_TOKEN=
